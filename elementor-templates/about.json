                  "widgetType": "text-editor",
                  "settings": {
                    "editor": "<p style=\"font-size:17px;line-height:1.8;color:#333;\">成都职业技术学院创意设计学院在读，主修视觉传达与数字媒体。三年系统训练覆盖设计基础、品牌视觉、UI 交互与三维建模，作品曾获华迪杯与四川职业技能大赛奖项。</p><p style=\"font-size:17px;line-height:1.8;color:#333;margin-top:16px;\">我相信好设计 = 审美 + 策略 + 执行力。正在寻找能让我持续成长的设计师岗位。</p>",
                    "typography": { "font_family": "Inter", "font_size": "17", "line_height": "1.8" }
                  },
                  "elements": []
                },
