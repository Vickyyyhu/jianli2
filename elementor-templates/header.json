{
  "version": "0.4",
  "title": "Header - 胡馨月 作品集",
  "type": "header",
  "content": [
    {
      "id": "header-root",
      "elType": "container",
      "settings": {
        "layout": "full_width",
        "sticky": "yes",
        "sticky_on": [ "desktop", "tablet", "mobile" ],
        "gap": "0px",
        "padding": { "unit": "px", "top": "16", "right": "24", "bottom": "16", "left": "24" },
        "background": { "type": "classic", "color": "#FFFFFF" },
        "border_bottom": { "unit": "px", "size": "1", "color": "#EFEFEF" },
        "flex_direction": "row",
        "flex_wrap": "nowrap",
        "align_items": "center"
      },
      "elements": [
        {
          "id": "header-inner",
          "elType": "container",
          "settings": {
            "layout": "constrained",
            "content_width": "1200px",
            "gap": "40px",
            "flex_direction": "row",
            "flex_wrap": "nowrap",
            "align_items": "center"
          },
          "elements": [
            {
              "id": "header-logo",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "<strong>胡馨月</strong> <span style=\"color:#999;font-weight:300;\">· Designer</span>",
                "size": "s",
                "align": "left",
                "title_color": "#0A0A0A",
                "link": { "url": "/", "is_external": false },
                "typography": { "font_family": "Inter", "font_size": "20", "font_weight": "600", "letter_spacing": "-0.5" },
                "header_size": "h4"
              },
              "elements": []
            },
            {
              "id": "header-menu",
              "elType": "container",
              "settings": {
                "gap": "32px",
                "flex_direction": "row",
                "flex_wrap": "nowrap",
                "align_items": "center",
                "justify_content": "flex_start"
              },
              "elements": [
                { "id": "nav-1", "elType": "widget", "widgetType": "heading", "settings": { "title": "<a href=\"/\" style=\"color:#0A0A0A;text-decoration:none;\">首页</a>", "size": "xs", "align": "left", "typography": { "font_family": "Inter", "font_size": "15", "font_weight": "500" }, "header_size": "h5" }, "elements": [] },
                { "id": "nav-2", "elType": "widget", "widgetType": "heading", "settings": { "title": "<a href=\"/about\" style=\"color:#0A0A0A;text-decoration:none;\">关于与简历</a>", "size": "xs", "align": "left", "typography": { "font_family": "Inter", "font_size": "15", "font_weight": "500" }, "header_size": "h5" }, "elements": [] },
                { "id": "nav-3", "elType": "widget", "widgetType": "heading", "settings": { "title": "<a href=\"/portfolio\" style=\"color:#0A0A0A;text-decoration:none;\">作品集</a>", "size": "xs", "align": "left", "typography": { "font_family": "Inter", "font_size": "15", "font_weight": "500" }, "header_size": "h5" }, "elements": [] },
                { "id": "nav-4", "elType": "widget", "widgetType": "heading", "settings": { "title": "<a href=\"/blog\" style=\"color:#0A0A0A;text-decoration:none;\">博客</a>", "size": "xs", "align": "left", "typography": { "font_family": "Inter", "font_size": "15", "font_weight": "500" }, "header_size": "h5" }, "elements": [] },
                { "id": "nav-5", "elType": "widget", "widgetType": "heading", "settings": { "title": "<a href=\"/contact\" style=\"color:#0A0A0A;text-decoration:none;\">联系我</a>", "size": "xs", "align": "left", "typography": { "font_family": "Inter", "font_size": "15", "font_weight": "500" }, "header_size": "h5" }, "elements": [] }
              ]
            },
            {
              "id": "header-spacer",
              "elType": "widget",
              "widgetType": "spacer",
              "settings": { "space": { "unit": "px", "size": null }, "flex": "1" },
              "elements": []
            },
            {
              "id": "header-cta",
              "elType": "widget",
              "widgetType": "button",
              "settings": {
                "text": "下载简历",
                "link": { "url": "/wp-content/uploads/resume-huxinyue.pdf", "is_external": false },
                "button_size": "sm",
                "background_color": "#002FA7",
                "text_color": "#FFFFFF",
                "border_radius": { "unit": "px", "top": "4", "right": "4", "bottom": "4", "left": "4" },
                "padding": { "unit": "px", "top": "10", "right": "24", "bottom": "10", "left": "24" },
                "typography": { "font_family": "Inter", "font_size": "14", "font_weight": "600" }
              },
              "elements": []
            }
          ]
        }
      ]
    }
  ],
  "page_settings": {}
}