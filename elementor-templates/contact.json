      "elements": [
        {
          "id": "contact-hero-inner",
          "elType": "container",
          "settings": {
            "layout": "constrained",
            "content_width": "1200px",
            "gap": "24px",
            "flex_direction": "column"
          },
          "elements": [
            {
              "id": "contact-kicker",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "CONTACT",
                "size": "xs",
                "align": "left",
                "title_color": "#002FA7",
                "typography": { "font_family": "Inter", "font_size": "13", "font_weight": "500", "letter_spacing": "3", "text_transform": "uppercase" },
                "header_size": "h4"
              },
              "elements": []
            },
            {
              "id": "contact-title",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "聊聊，或者直接给个 offer",
                "size": "xxl",
                "align": "left",
                "title_color": "#0A0A0A",
                "typography": { "font_family": "Inter", "font_size": "56", "font_weight": "700", "letter_spacing": "-1.5", "line_height": "1.1" },
                "header_size": "h1"
              },
              "elements": []
            },
            {
              "id": "contact-desc",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<p style=\"font-size:17px;color:#666;max-width:600px;line-height:1.7;\">无论是面试邀请、外包合作还是单纯想聊聊设计，都欢迎通过下面的方式联系我。24 小时内回复。</p>",
                "typography": { "font_family": "Inter", "font_size": "17" }
              },
              "elements": []
            }
          ]
        }
      ]
    },
